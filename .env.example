NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=la_contrasena_de_tu_instancia
NEO4J_DATABASE=linkedun

# Seguridad (opcional, estos son los valores por defecto)
SESION_HORAS=8
SESION_INACTIVIDAD_MIN=120
MAX_INTENTOS=5
BLOQUEO_MIN=15
# Ponlo en true cuando la app se sirva por HTTPS (la cookie viajara solo cifrada)
COOKIE_SECURE=false
